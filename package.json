{
  "name": "hackathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:convex": "convex dev",
    "dev:all": "concurrently -n web,convex -c blue,magenta \"bun run dev\" \"bun run dev:convex\"",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/core tests/execution",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test --config tests/browser/playwright.config.ts",
    "test:preflight": "tsx scripts/preflight.ts",
    "test:persona": "vitest run tests/core/persona",
    "test:all": "bun run lint && bun run typecheck && bun run test && FDE_NEXT_DIST_DIR=.next-e2e bun run build && bun run test:e2e",
    "dev:demo": "FDE_DEMO_MODE=true next dev --hostname 127.0.0.1"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.66",
    "@convex-dev/agent": "^0.7.2",
    "@convex-dev/workflow": "^0.4.7",
    "@noble/hashes": "^2.4.0",
    "ai": "^7.0.99",
    "convex": "^1.45.0",
    "dotenv": "^17.4.2",
    "next": "16.3.5",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "twitter-text": "^3.1.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/twitter-text": "^3.1.10",
    "concurrently": "^10.0.5",
    "convex-test": "^0.0.58",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "bun@1.4.2"
}
